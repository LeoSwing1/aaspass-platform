# AasPass local/backend configuration
NODE_ENV=development
PORT=4100
DATABASE_URL=postgres://aaspass:aaspass_dev@localhost:5432/aaspass
DATABASE_SSL=false
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=replace-before-production
JWT_ISSUER=aaspass-api
JWT_AUDIENCE=aaspass-client
DEV_AUTH_ENABLED=true
DEV_OTP=270303
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=10
WEBHOOK_RATE_LIMIT_MAX=120
CASHFREE_MODE=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
DEFAULT_ZONE_NAME=Lucknow Pilot
DEFAULT_ZONE_LATITUDE=26.8467
DEFAULT_ZONE_LONGITUDE=80.9462
DEFAULT_SERVICE_RADIUS_KM=10
MAPS_PROVIDER=haversine
GOOGLE_ROUTES_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
KYC_PROVIDER=not-configured
KYC_API_KEY=
STORAGE_PROVIDER=not-configured
STORAGE_BUCKET=
NOTIFICATION_DISPATCH_BATCH_SIZE=25
NOTIFICATION_DISPATCH_ENABLED=true
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
DELIVERY_OTP_SECRET=replace-before-production
